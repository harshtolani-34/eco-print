<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#171B18"
        android:orientation="vertical"
        android:padding="18dp">

    <TextView
            android:id="@+id/typeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plastic"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/weightText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0.00 kg collected"
            android:textColor="#7CFF5B"
            android:textSize="16sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/reportIdText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#A8B0AB"
            android:textSize="13sp" />

    <TextView
            android:id="@+id/dateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#8A918D"
            android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/createBatchButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="CREATE PROCESSING BATCH" />
</LinearLayout>
