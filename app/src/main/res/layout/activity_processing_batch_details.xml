<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0F0E">

    <ScrollView
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <ImageButton
                        android:id="@+id/backButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Back"
                        android:src="@android:drawable/ic_media_previous" />

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Batch Details"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/stageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Received"
                        android:textColor="#7CFF5B"
                        android:textSize="14sp"
                        android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="#171B18"
                    android:orientation="vertical"
                    android:padding="18dp">

                <TextView
                        android:text="Batch ID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8A918D"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/batchIdText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Source Report"
                        android:textColor="#8A918D"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/reportIdText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Plastic Type"
                        android:textColor="#8A918D"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/plasticTypeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#171B18"
                    android:orientation="vertical"
                    android:padding="18dp">

                <TextView
                        android:text="Input Weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8A918D" />
                <TextView
                        android:id="@+id/inputWeightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:text="Usable Weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#8A918D" />
                <TextView
                        android:id="@+id/usableWeightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#7CFF5B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:text="Rejected Weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#8A918D" />
                <TextView
                        android:id="@+id/rejectedWeightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FF8A80"
                        android:textSize="18sp"
                        android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#171B18"
                    android:orientation="vertical"
                    android:padding="18dp">

                <TextView
                        android:text="Notes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8A918D" />

                <TextView
                        android:id="@+id/notesText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                <TextView
                        android:text="Completed At"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="#8A918D" />

                <TextView
                        android:id="@+id/completedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/stageButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="MOVE TO NEXT STAGE" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/createFilamentButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="ADD FILAMENT OUTPUT"
                    android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
</FrameLayout>
