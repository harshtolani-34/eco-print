<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

    <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_previous"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

    <LinearLayout
            android:id="@+id/titleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/backButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/backButton"
            app:layout_constraintTop_toTopOf="@id/backButton">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Report Plastic Waste"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="A clear photo and location help collectors respond faster."
                android:textColor="#8D8D8D"
                android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
            android:id="@+id/formScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/backButton">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="36dp">

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Waste photo"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Required · Keep the waste clearly visible in the frame."
                            android:textColor="#979797"
                            android:textSize="13sp" />

                    <FrameLayout
                            android:id="@+id/imagePreviewContainer"
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/report_preview_background"
                            android:clipToOutline="true"
                            android:padding="5dp">

                        <ImageView
                                android:id="@+id/wasteImageView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Selected waste photo"
                                android:scaleType="centerCrop" />

                        <LinearLayout
                                android:id="@+id/imageEmptyState"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="24dp">

                            <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:contentDescription="Add photo"
                                    android:src="@drawable/ic_add_photo" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:text="Add a photo of the waste"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center"
                                    android:text="Choose one from your gallery or take a new photo."
                                    android:textColor="#888888"
                                    android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                                android:id="@+id/imageSelectedBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|start"
                                android:layout_margin="12dp"
                                android:background="@drawable/report_badge_background"
                                android:text="PHOTO READY"
                                android:textColor="#7CFF5B"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/removeImageButton"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="8dp"
                                android:text="REMOVE"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:visibility="gone"
                                app:backgroundTint="#B3000000"
                                app:cornerRadius="20dp" />
                    </FrameLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/galleryButton"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:text="GALLERY"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                app:backgroundTint="#222222"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_gallery"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconTint="#FFFFFF" />

                        <Space
                                android:layout_width="10dp"
                                android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/cameraButton"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:text="CAMERA"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                app:backgroundTint="#222222"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_camera"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconTint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Waste details"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Plastic type (Optional)"
                            android:textColor="#D7D7D7"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    <Spinner
                            android:id="@+id/wasteTypeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:paddingStart="4dp"
                            android:paddingEnd="10dp"
                            android:popupBackground="#222222" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Estimated weight in kg (Optional)"
                            android:textColor="#D7D7D7"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    <EditText
                            android:id="@+id/weightEditText"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:hint="Example: 2.5"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#777777" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Description"
                            android:textColor="#D7D7D7"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    <EditText
                            android:id="@+id/descriptionEditText"
                            android:layout_width="match_parent"
                            android:layout_height="126dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/input_background"
                            android:gravity="top|start"
                            android:hint="Describe what you found and where it is placed..."
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="500"
                            android:padding="14dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#777777" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Required · Minimum 10 characters"
                            android:textColor="#777777"
                            android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Waste location"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Required · This is shared with the assigned collector."
                            android:textColor="#979797"
                            android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/locationButton"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp"
                            android:text="USE CURRENT LOCATION"
                            android:textColor="#7CFF5B"
                            android:textStyle="bold"
                            app:backgroundTint="#222222"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_location"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconTint="#7CFF5B" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/input_background"
                            android:orientation="vertical"
                            android:padding="14dp">

                        <TextView
                                android:id="@+id/locationStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No location selected"
                                android:textColor="#FFC857"
                                android:textStyle="bold" />

                        <TextView
                                android:id="@+id/coordinatesText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Latitude: --&#10;Longitude: --"
                                android:textColor="#CCCCCC"
                                android:textSize="13sp" />

                        <TextView
                                android:id="@+id/addressText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Address will appear here"
                                android:textColor="#AAAAAA"
                                android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                    android:id="@+id/loadingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/report_loading_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:indeterminateTint="#7CFF5B" />

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <TextView
                            android:id="@+id/loadingStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Preparing your report..."
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Please keep this screen open."
                            android:textColor="#9A9A9A"
                            android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="18dp"
                    android:text="SUBMIT REPORT"
                    android:textColor="#071200"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#7CFF5B"
                    app:cornerRadius="16dp" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Your report will first be saved with Pending status."
                    android:textColor="#777777"
                    android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
