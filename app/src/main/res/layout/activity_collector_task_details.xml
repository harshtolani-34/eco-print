<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

    <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/module4_back"
            android:src="@android:drawable/ic_media_previous"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

    <TextView
            android:id="@+id/pageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/module4_collection_details"
            android:textColor="#7CFF5B"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/backButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/backButton" />

    <ProgressBar
            android:id="@+id/detailProgress"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:indeterminateTint="#7CFF5B"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/backButton" />

    <ScrollView
            android:id="@+id/detailsScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="28dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/backButton">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="30dp">

            <ImageView
                    android:id="@+id/reportImage"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:contentDescription="@string/module4_waste_report_image"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="@string/module4_status_assigned"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                <TextView
                        android:id="@+id/reportIdText"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="@string/module4_report_id"
                        android:textColor="#777777"
                        android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/report_section_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/module4_waste_information"
                        android:textColor="#7CFF5B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/plasticTypeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/module4_plastic_type"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/weightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/module4_weight"
                        android:textColor="#BBBBBB"
                        android:textSize="15sp" />

                <TextView
                        android:id="@+id/descriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/module4_description"
                        android:textColor="#DDDDDD"
                        android:textSize="14sp" />
            </LinearLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/module4_waste_location"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/addressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/module4_address"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp" />

            <TextView
                    android:id="@+id/coordinatesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/module4_latitude_longitude"
                    android:textColor="#777777"
                    android:textSize="12sp" />

            <org.osmdroid.views.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="270dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/module4_map_description" />

            <TextView
                    android:id="@+id/mapAttributionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="end"
                    android:text="@string/module4_osm_attribution"
                    android:textColor="#888888"
                    android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/openMapButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/module4_open_in_osm"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="#202020"
                    app:cornerRadius="14dp"
                    app:strokeColor="#7CFF5B"
                    app:strokeWidth="1dp" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/report_section_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/module4_collection_timeline"
                        android:textColor="#7CFF5B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/assignedAtText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/module4_assigned_placeholder"
                        android:textColor="#DDDDDD"
                        android:textSize="14sp" />

                <TextView
                        android:id="@+id/startedAtText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/module4_started_placeholder"
                        android:textColor="#DDDDDD"
                        android:textSize="14sp" />

                <TextView
                        android:id="@+id/collectedAtText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/module4_collected_placeholder"
                        android:textColor="#DDDDDD"
                        android:textSize="14sp" />
            </LinearLayout>

            <TextView
                    android:id="@+id/completedMessageText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/report_cta_background"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/module4_collection_completed"
                    android:textColor="#7CFF5B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/statusActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/module4_start_collection"
                    android:textColor="#071200"
                    android:textStyle="bold"
                    app:backgroundTint="#7CFF5B"
                    app:cornerRadius="15dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
