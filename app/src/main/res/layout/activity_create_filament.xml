<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0F0E"
        android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Back"
                    android:src="@android:drawable/ic_media_previous" />

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Add Filament Output"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <TextView
                android:id="@+id/batchText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#A8B0AB"
                android:textSize="13sp" />

        <TextView
                android:id="@+id/usableWeightText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#7CFF5B"
                android:textSize="15sp" />

        <EditText
                android:id="@+id/materialTypeEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/input_background"
                android:hint="Material / filament type"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A918D" />

        <EditText
                android:id="@+id/colourEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_background"
                android:hint="Filament colour (optional)"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A918D" />

        <EditText
                android:id="@+id/diameterEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_background"
                android:hint="Diameter in mm"
                android:inputType="numberDecimal"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A918D" />

        <EditText
                android:id="@+id/outputWeightEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_background"
                android:hint="Produced filament weight (kg)"
                android:inputType="numberDecimal"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A918D" />

        <EditText
                android:id="@+id/spoolCountEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_background"
                android:hint="Spool count"
                android:inputType="number"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A918D" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/createButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="ADD FILAMENT TO INVENTORY" />
    </LinearLayout>
</ScrollView>
