<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Dashboard"
                android:textColor="#7CFF5B"
                android:textSize="28sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/greetingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Administrator access active"
                android:textColor="#A0A0A0"
                android:textSize="14sp" />

        <TextView
                android:id="@+id/dashboardStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/report_section_background"
                android:padding="16dp"
                android:text="Loading administrator summary..."
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:background="@drawable/report_section_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                <TextView
                        android:id="@+id/pendingCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFC857"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending reports"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />
            </LinearLayout>

            <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:background="@drawable/report_section_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                <TextView
                        android:id="@+id/verifiedCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#4DA3FF"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verified reports"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:background="@drawable/report_section_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                <TextView
                        android:id="@+id/rejectedCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FF5C5C"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rejected reports"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />
            </LinearLayout>

            <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:background="@drawable/report_section_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                <TextView
                        android:id="@+id/duplicateCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FF9F43"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Possible duplicates"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/report_section_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending collector applications"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Approve applicants before collector access is enabled."
                        android:textColor="#999999"
                        android:textSize="12sp" />
            </LinearLayout>

            <TextView
                    android:id="@+id/pendingCollectorCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="0"
                    android:textColor="#FFC857"
                    android:textSize="32sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <Button
                android:id="@+id/reviewReportsButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#66CC33"
                android:text="REVIEW PENDING REPORTS"
                android:textColor="#071200"
                android:textStyle="bold" />

        <Button
                android:id="@+id/collectorApplicationsButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#1A1A1A"
                android:text="MANAGE COLLECTOR APPLICATIONS"
                android:textColor="#7CFF5B"
                android:textStyle="bold" />

        <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#2A1010"
                android:text="LOGOUT ADMIN"
                android:textColor="#FF7777"
                android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
