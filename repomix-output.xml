<file path="app/src/main/res/layout/activity_report_details.xml">
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

    <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_media_previous"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

    <TextView
            android:id="@+id/pageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            android:text="Report Details"
            android:textColor="#7CFF5B"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/backButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/backButton"
            app:layout_constraintTop_toTopOf="@id/backButton" />

    <ScrollView
            android:id="@+id/detailsScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/backButton">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

            <ImageView
                    android:id="@+id/reportImage"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="@drawable/report_card_background"
                    android:contentDescription="Waste report image"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <TextView
                        android:id="@+id/plasticTypeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PET Bottles"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:paddingStart="13dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="7dp"
                        android:text="Pending"
                        android:textSize="13sp"
                        android:textStyle="bold" />
            </LinearLayout>

            <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="10 Jul 2026, 12:30 PM"
                    android:textColor="#999999"
                    android:textSize="13sp" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/report_card_background"
                    android:orientation="vertical"
                    android:padding="18dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Collection Status"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="This tracker updates whenever the database status changes."
                        android:textColor="#888888"
                        android:textSize="12sp" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="38dp"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                        <TextView
                                android:id="@+id/stepDot1"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />
                        <View
                                android:id="@+id/line1"
                                android:layout_width="3dp"
                                android:layout_height="35dp"
                                android:background="#555555" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/stepLabel1"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="Report Submitted"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="38dp"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                        <TextView
                                android:id="@+id/stepDot2"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:gravity="center"
                                android:text="2"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />
                        <View
                                android:id="@+id/line2"
                                android:layout_width="3dp"
                                android:layout_height="35dp"
                                android:background="#555555" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/stepLabel2"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="Verified"
                            android:textColor="#888888"
                            android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="38dp"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                        <TextView
                                android:id="@+id/stepDot3"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:gravity="center"
                                android:text="3"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />
                        <View
                                android:id="@+id/line3"
                                android:layout_width="3dp"
                                android:layout_height="35dp"
                                android:background="#555555" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/stepLabel3"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="Collector Assigned"
                            android:textColor="#888888"
                            android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="38dp"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                        <TextView
                                android:id="@+id/stepDot4"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:gravity="center"
                                android:text="4"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />
                        <View
                                android:id="@+id/line4"
                                android:layout_width="3dp"
                                android:layout_height="35dp"
                                android:background="#555555" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/stepLabel4"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="Collection In Progress"
                            android:textColor="#888888"
                            android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="38dp"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                        <TextView
                                android:id="@+id/stepDot5"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:gravity="center"
                                android:text="5"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/stepLabel5"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="Waste Collected"
                            android:textColor="#888888"
                            android:textSize="15sp" />
                </LinearLayout>

                <TextView
                        android:id="@+id/rejectedNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/rejected_notice_background"
                        android:padding="12dp"
                        android:text="This report was rejected during verification. It may require corrected information or a clearer image."
                        android:textColor="#FF8A8A"
                        android:textSize="13sp"
                        android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/report_card_background"
                    android:orientation="vertical"
                    android:padding="18dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Report Information"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Estimated Weight"
                        android:textColor="#888888"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/weightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="2.50 kg"
                        android:textColor="#7CFF5B"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Description"
                        android:textColor="#888888"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/descriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Plastic bottles beside the road."
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                <TextView
                        android:layout_width="wrap_content"
